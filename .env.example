# BloodLink - Example Environment Configuration
# Copy this file to .env for custom port or container URL overrides

# Inventory Service
INVENTORY_SERVICE_PORT=5001
INVENTORY_DB_PATH=data/inventory.db

# Request and Matching Service
REQUEST_SERVICE_PORT=5002
REQUEST_DB_PATH=data/requests.db
INVENTORY_SERVICE_URL=http://localhost:5001
REQUEST_TIMEOUT=5.0

# Notification Service
NOTIFICATION_SERVICE_PORT=5003
NOTIFICATION_DB_PATH=data/notifications.db
ENABLE_RABBITMQ=true

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
